include README.md NOTICE CONTRIBUTING.md SECURITY.md
include pyproject.toml .python-version .env.example Dockerfile compose.yaml
recursive-include src *.py py.typed
recursive-include src/platform/orchestrator *.md
recursive-include src/platform/orchestrator/decision/prompts *.j2
include src/platform/orchestrator/.env.example
exclude src/platform/orchestrator/.env
recursive-include requirements *.lock
recursive-include contracts *.json *.proto *.md
recursive-include configs *.yaml
recursive-include scripts *.py *.ps1
recursive-include infrastructure *.yaml *.sh *.tf *.md
recursive-include database *.sql *.md
recursive-include docs *.md
recursive-include tests *.py *.md
recursive-include dashboard *.html *.md
recursive-include ml *.py *.md
recursive-include experiments *.yaml
recursive-exclude src/generated *_pb2.py *_pb2_grpc.py
