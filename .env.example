# Local development only. Never put live credentials in this file.
PIDS_ENVIRONMENT=local
PIDS_RUNTIME_MODE=skeleton
PIDS_SERVICE_NAME=platform-api
PIDS_LOG_LEVEL=INFO
PIDS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PIDS_POSTGRES_DSN=postgresql://pids:local-development-only@localhost:5432/pids
PIDS_REDIS_URL=redis://localhost:6379/0
PIDS_QDRANT_URL=http://localhost:6333
PIDS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
PIDS_MLFLOW_TRACKING_URI=http://localhost:5000
PIDS_CONTEXT_GRPC_TARGET=localhost:50051
PIDS_HITL_GRPC_TARGET=localhost:50052
PIDS_PROMETHEUS_URL=http://localhost:9090
PIDS_LOKI_URL=http://localhost:3100
# Optional (Agent 1 log labels). Never commit a real key: put it in .env only.
PIDS_GEMINI_API_KEY=
PIDS_GEMINI_MODEL=gemini-2.5-flash
