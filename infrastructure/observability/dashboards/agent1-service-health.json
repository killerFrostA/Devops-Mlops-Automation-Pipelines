{
  "uid": "agent1-service-health",
  "title": "Agent 1 - Sante du service observe",
  "description": "Ce que l'Agent 1 observe : memoire, erreurs, latence, trafic et messages d'erreur du service.",
  "tags": [
    "agent1",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total, service_id)",
          "refId": "service"
        },
        "refresh": 2,
        "current": {
          "text": "payment-service",
          "value": "payment-service"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memoire du service (Mo)",
      "description": "Une croissance reguliere est detectee par la couche statistique (memory_pressure).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes{service_id=\"$service\"}) / 1048576",
          "legendFormat": "memoire"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taux d'erreur (%)",
      "description": "Le SLO autorise 0,5 % d'erreurs. Au-dessus, le budget d'erreur brule.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{service_id=\"$service\",path!~\"/health.*|/metrics|/chaos.*\",handler!~\"/health.*|/metrics|/chaos.*\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_requests_total{service_id=\"$service\",path!~\"/health.*|/metrics|/chaos.*\",handler!~\"/health.*|/metrics|/chaos.*\"}[1m]))",
          "legendFormat": "erreurs"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latence p95 (ms)",
      "description": "La ligne rouge est la limite du SLO (500 ms). Sous la limite, seule la couche statistique voit un changement.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service_id=\"$service\",path!~\"/health.*|/metrics|/chaos.*\",handler!~\"/health.*|/metrics|/chaos.*\"}[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Trafic (requetes par seconde)",
      "description": "Sans trafic, l'agent repond INSUFFICIENT_DATA au lieu de juger.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service_id=\"$service\",path!~\"/health.*|/metrics|/chaos.*\",handler!~\"/health.*|/metrics|/chaos.*\"}[1m]))",
          "legendFormat": "requetes/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU du service (coeurs)",
      "description": "Meme mesure que l'agent (cpu_cores). Un saut par rapport a l'habitude est detecte par la couche statistique et par Chronos (cpu_pressure). 1 = un coeur entier.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_cpu_seconds_total{service_id=\"$service\"}[1m]))",
          "legendFormat": "coeurs"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Messages d'erreur du service (Loki)",
      "description": "Les lignes que la couche Logs regroupe avec Drain3.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_id=\"$service\"} |~ `ERROR|CRITICAL|FATAL|WARN|Traceback|Exception`"
        }
      ]
    }
  ]
}
