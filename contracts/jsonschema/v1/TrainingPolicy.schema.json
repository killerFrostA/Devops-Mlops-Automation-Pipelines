{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_categorical_features": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Candidate Categorical Features",
      "type": "array"
    },
    "candidate_numeric_features": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Candidate Numeric Features",
      "type": "array"
    },
    "champion_features": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Champion Features",
      "type": "array"
    },
    "max_p95_latency_ms": {
      "default": 200.0,
      "exclusiveMinimum": 0,
      "title": "Max P95 Latency Ms",
      "type": "number"
    },
    "min_f1_gain": {
      "default": 0.02,
      "maximum": 1,
      "minimum": 0,
      "title": "Min F1 Gain",
      "type": "number"
    },
    "min_positive_per_split": {
      "default": 5,
      "minimum": 1,
      "title": "Min Positive Per Split",
      "type": "integer"
    },
    "min_test_samples": {
      "default": 50,
      "minimum": 1,
      "title": "Min Test Samples",
      "type": "integer"
    },
    "min_training_samples": {
      "default": 200,
      "minimum": 1,
      "title": "Min Training Samples",
      "type": "integer"
    },
    "min_validation_samples": {
      "default": 50,
      "minimum": 1,
      "title": "Min Validation Samples",
      "type": "integer"
    },
    "pipeline_version": {
      "default": "machine-logistic-v1",
      "maxLength": 128,
      "minLength": 1,
      "title": "Pipeline Version",
      "type": "string"
    },
    "random_state": {
      "default": 42,
      "title": "Random State",
      "type": "integer"
    },
    "require_recall_nonregression": {
      "default": true,
      "title": "Require Recall Nonregression",
      "type": "boolean"
    },
    "version": {
      "default": "agent6-training-demo-v1",
      "maxLength": 128,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "champion_features",
    "candidate_numeric_features"
  ],
  "title": "TrainingPolicy",
  "type": "object"
}
