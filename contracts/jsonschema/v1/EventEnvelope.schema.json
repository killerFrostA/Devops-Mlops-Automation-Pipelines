  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "topic": {
            "const": "approval.requested"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "APPROVAL_REQUESTED"
          },
          "payload": {
            "$ref": "#/$defs/ApprovalRequested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "approval.resolved"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "APPROVAL_RESOLVED"
          },
          "payload": {
            "$ref": "#/$defs/ApprovalResolved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "deployment.action.completed"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "ACTION_COMPLETED"
          },
          "payload": {
            "$ref": "#/$defs/ActionCompleted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "deployment.action.requested"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "ACTION_REQUESTED"
          },
          "payload": {
            "$ref": "#/$defs/ActionRequest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "diagnosis.completed"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "DIAGNOSIS_COMPLETED"
          },
          "payload": {
            "$ref": "#/$defs/DiagnosisCompleted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "mlops.model.health.assessed"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "MODEL_HEALTH_ASSESSED"
          },
          "payload": {
            "$ref": "#/$defs/ModelHealthAssessed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "monitoring.anomaly.detected"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "ANOMALY_DETECTED"
          },
          "payload": {
            "$ref": "#/$defs/AnomalyDetected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "monitoring.recovery.verified"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "RECOVERY_VERIFIED"
          },
          "payload": {
            "$ref": "#/$defs/RecoveryVerified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "quality.release.assessed"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "RELEASE_ASSESSMENT"
          },
          "payload": {
            "$ref": "#/$defs/ReleaseAssessment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "resource.recommendation.created"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "RESOURCE_RECOMMENDATION"
          },
          "payload": {
            "$ref": "#/$defs/ResourceRecommendation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "workflow.continuation"
          }
        },
        "required": [
          "topic"
        ]
      },
      "then": {
        "properties": {
          "message_type": {
            "const": "WORKFLOW_CONTINUATION"
          },
          "payload": {
            "$ref": "#/$defs/WorkflowContinuation"
          }
        }
      }
    }
