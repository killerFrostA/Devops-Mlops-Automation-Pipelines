{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checksum_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checksum Sha256",
      "type": "string"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "object_uri": {
      "title": "Object Uri",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "incident_id",
    "source",
    "object_uri",
    "checksum_sha256",
    "observed_at"
  ],
  "title": "EvidenceReference",
  "type": "object"
}
