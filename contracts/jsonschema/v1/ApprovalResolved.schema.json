{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "title": "Action Id",
      "type": "string"
    },
    "action_version": {
      "minimum": 1,
      "title": "Action Version",
      "type": "integer"
    },
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "approver_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approver Id"
    },
    "comment": {
      "title": "Comment",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "action_id",
    "action_version",
    "decision",
    "comment"
  ],
  "title": "ApprovalResolved",
  "type": "object"
}
