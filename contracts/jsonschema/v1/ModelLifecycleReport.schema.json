{
  "$defs": {
    "CandidateEvaluation": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/ClassificationMetrics"
        },
        "candidate_model_uri": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Model Uri",
          "type": "string"
        },
        "candidate_validation": {
          "$ref": "#/$defs/ClassificationMetrics"
        },
        "champion": {
          "$ref": "#/$defs/ClassificationMetrics"
        },
        "dataset_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Ref",
          "type": "string"
        },
        "dataset_sha256": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Sha256",
          "type": "string"
        },
        "model_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "pipeline_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/TrainingPolicy"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "test_samples": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Test Samples",
          "type": "integer"
        },
        "train_samples": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Train Samples",
          "type": "integer"
        },
        "validation_samples": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Validation Samples",
          "type": "integer"
        }
      },
      "required": [
        "model_name",
        "pipeline_version",
        "dataset_ref",
        "dataset_sha256",
        "run_id",
        "candidate_model_uri",
        "train_samples",
        "validation_samples",
        "test_samples",
        "champion",
        "candidate",
        "candidate_validation",
        "policy"
      ],
      "title": "CandidateEvaluation",
      "type": "object"
    },
    "ClassificationMetrics": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Accuracy",
          "type": "number"
        },
        "f1": {
          "maximum": 1,
          "minimum": 0,
          "title": "F1",
          "type": "number"
        },
        "false_negatives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "False Negatives",
          "type": "integer"
        },
        "false_positives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "False Positives",
          "type": "integer"
        },
        "p95_latency_ms": {
          "minimum": 0,
          "title": "P95 Latency Ms",
          "type": "number"
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall",
          "type": "number"
        },
        "true_negatives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "True Negatives",
          "type": "integer"
        },
        "true_positives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "True Positives",
          "type": "integer"
        }
      },
      "required": [
        "f1",
        "precision",
        "recall",
        "accuracy",
        "p95_latency_ms",
        "true_positives",
        "false_positives",
        "false_negatives",
        "true_negatives"
      ],
      "title": "ClassificationMetrics",
      "type": "object"
    },
    "DistributionHealth": {
      "additionalProperties": false,
      "properties": {
        "current_samples": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Current Samples",
          "type": "integer"
        },
        "detected": {
          "title": "Detected",
          "type": "boolean"
        },
        "method": {
          "const": "PSI",
          "default": "PSI",
          "title": "Method",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reference_samples": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Reference Samples",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "feature",
            "prediction"
          ],
          "title": "Scope",
          "type": "string"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "threshold": {
          "exclusiveMinimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "name",
        "scope",
        "score",
        "threshold",
        "detected",
        "reference_samples",
        "current_samples"
      ],
      "title": "DistributionHealth",
      "type": "object"
    },
    "ModelHealthAssessed": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "title": "Assessment Id",
          "type": "string"
        },
        "dataset_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Ref"
        },
        "decision": {
          "enum": [
            "HEALTHY",
            "COLLECT_LABELS",
            "RETRAIN_AND_EVALUATE"
          ],
          "title": "Decision",
          "type": "string"
        },
        "drift_detected": {
          "title": "Drift Detected",
          "type": "boolean"
        },
        "drift_score": {
          "minimum": 0,
          "title": "Drift Score",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "model_name",
        "model_version",
        "drift_detected",
        "drift_score",
        "decision",
        "evidence_refs"
      ],
      "title": "ModelHealthAssessed",
      "type": "object"
    },
    "ModelHealthPolicy": {
      "additionalProperties": false,
      "description": "Initial tunable thresholds; require calibration on representative data.",
      "properties": {
        "epsilon": {
          "default": 1e-06,
          "maximum": 0.01,
          "minimum": 1e-12,
          "title": "Epsilon",
          "type": "number"
        },
        "max_f1_drop": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max F1 Drop",
          "type": "number"
        },
        "min_distribution_samples": {
          "default": 100,
          "minimum": 1,
          "title": "Min Distribution Samples",
          "type": "integer"
        },
        "min_ground_truth_coverage": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Ground Truth Coverage",
          "type": "number"
        },
        "min_labeled_samples": {
          "default": 30,
          "minimum": 1,
          "title": "Min Labeled Samples",
          "type": "integer"
        },
        "min_positive_labels": {
          "default": 5,
          "minimum": 1,
          "title": "Min Positive Labels",
          "type": "integer"
        },
        "psi_threshold": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "title": "Psi Threshold",
          "type": "number"
        },
        "version": {
          "default": "agent6-health-v1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "title": "ModelHealthPolicy",
      "type": "object"
    },
    "ModelHealthReport": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "$ref": "#/$defs/ModelHealthAssessed"
        },
        "distributions": {
          "items": {
            "$ref": "#/$defs/DistributionHealth"
          },
          "title": "Distributions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "performance": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerformanceHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/ModelHealthPolicy"
        },
        "rationale_summary": {
          "title": "Rationale Summary",
          "type": "string"
        },
        "reference_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "assessment",
        "reference_id",
        "window_start",
        "window_end",
        "distributions",
        "performance",
        "policy",
        "rationale_summary",
        "limitations"
      ],
      "title": "ModelHealthReport",
      "type": "object"
    },
    "PerformanceHealth": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "maximum": 1,
          "minimum": 0,
          "title": "Baseline",
          "type": "number"
        },
        "current": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current"
        },
        "degraded": {
          "title": "Degraded",
          "type": "boolean"
        },
        "drop": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drop"
        },
        "false_negatives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "False Negatives",
          "type": "integer"
        },
        "false_positives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "False Positives",
          "type": "integer"
        },
        "ground_truth_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ground Truth Coverage",
          "type": "number"
        },
        "labeled_samples": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Labeled Samples",
          "type": "integer"
        },
        "metric": {
          "const": "f1",
          "default": "f1",
          "title": "Metric",
          "type": "string"
        },
        "positive_labels": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Positive Labels",
          "type": "integer"
        },
        "sufficient_labels": {
          "title": "Sufficient Labels",
          "type": "boolean"
        },
        "true_positives": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "True Positives",
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "current",
        "drop",
        "ground_truth_coverage",
        "labeled_samples",
        "positive_labels",
        "true_positives",
        "false_positives",
        "false_negatives",
        "sufficient_labels",
        "degraded"
      ],
      "title": "PerformanceHealth",
      "type": "object"
    },
    "TrainingPolicy": {
      "additionalProperties": false,
      "properties": {
        "candidate_categorical_features": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Candidate Categorical Features",
          "type": "array"
        },
        "candidate_numeric_features": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Candidate Numeric Features",
          "type": "array"
        },
        "champion_features": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Champion Features",
          "type": "array"
        },
        "max_p95_latency_ms": {
          "default": 200.0,
          "exclusiveMinimum": 0,
          "title": "Max P95 Latency Ms",
          "type": "number"
        },
        "min_f1_gain": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Min F1 Gain",
          "type": "number"
        },
        "min_positive_per_split": {
          "default": 5,
          "minimum": 1,
          "title": "Min Positive Per Split",
          "type": "integer"
        },
        "min_test_samples": {
          "default": 50,
          "minimum": 1,
          "title": "Min Test Samples",
          "type": "integer"
        },
        "min_training_samples": {
          "default": 200,
          "minimum": 1,
          "title": "Min Training Samples",
          "type": "integer"
        },
        "min_validation_samples": {
          "default": 50,
          "minimum": 1,
          "title": "Min Validation Samples",
          "type": "integer"
        },
        "pipeline_version": {
          "default": "machine-logistic-v1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "random_state": {
          "default": 42,
          "title": "Random State",
          "type": "integer"
        },
        "require_recall_nonregression": {
          "default": true,
          "title": "Require Recall Nonregression",
          "type": "boolean"
        },
        "version": {
          "default": "agent6-training-demo-v1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "champion_features",
        "candidate_numeric_features"
      ],
      "title": "TrainingPolicy",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "SKIP_TRAINING",
        "KEEP_CHAMPION",
        "REQUEST_PROMOTION_REVIEW"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateEvaluation"
        },
        {
          "type": "null"
        }
      ]
    },
    "health": {
      "$ref": "#/$defs/ModelHealthReport"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "rationale_summary": {
      "title": "Rationale Summary",
      "type": "string"
    },
    "registered_model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registered Model Version"
    }
  },
  "required": [
    "health",
    "evaluation",
    "decision",
    "rationale_summary",
    "limitations"
  ],
  "title": "ModelLifecycleReport",
  "type": "object"
}
